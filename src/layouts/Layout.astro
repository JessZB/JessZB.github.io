---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeCurtain from '../components/ThemeCurtain.astro';
import esData from '../data/es.ts';
import enData from '../data/en.ts';

interface Props {
  title?: string;
  description?: string;
  locale?: 'es' | 'en';
  ogImage?: string;
  canonicalPath?: string;
}

const {
  title,
  description,
  locale = 'es',
  ogImage = '/og-image.png',
  canonicalPath = '',
} = Astro.props;

const siteName = 'JESSZB.DEV';
const siteUrl = 'https://jesszb.github.io';
const pageTitle = title
  ? `${title} | ${siteName}`
  : `${siteName} — Jesús Zapata | Computer Engineer & Full-Stack Developer`;
const pageDesc =
  description ||
  (locale === 'es'
    ? 'Portafolio de Jesús Zapata — Ingeniero en Informática y Desarrollador Full-Stack venezolano con más de 3 años de experiencia profesional.'
    : 'Portfolio of Jesús Zapata — Venezuelan Computer Engineer and Full-Stack Developer with 3+ years of professional experience.');

const canonicalUrl = `${siteUrl}${canonicalPath}`;

// Pass translations as JSON strings for client-side i18n engine
const translations = {
  es: JSON.stringify(esData),
  en: JSON.stringify(enData),
};
---

<!doctype html>
<html lang={locale} data-theme="arepa" data-lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDesc} />
    <meta name="author" content="Jesús Zapata" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#F5C542" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — Jesús Zapata, Computer Engineer & Full-Stack Developer`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale === 'es' ? 'es_VE' : 'en_US'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Fonts (self-hosted; preload only the above-the-fold files) -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/chakra-petch-latin-700.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/chakra-petch-latin-400.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/chakra-petch-latin-500.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/chakra-petch-latin-600.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/inter-latin-400-700.woff2" />

    <!-- Structured Data: Person -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Jesús Zapata",
        "url": "https://jesszb.github.io",
        "jobTitle": "Computer Engineer & Full-Stack Developer",
        "nationality": "Venezuelan",
        "sameAs": [
          "https://github.com/JessZB",
          "https://www.linkedin.com/in/tech-jesus-zapata/"
        ]
      }
    </script>

    <!-- Theme Init (must run BEFORE paint to avoid flash) -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('jesszb-theme');
        var theme;
        if (stored) {
          theme = stored === 'coffee' ? 'coffee' : 'arepa';
        } else {
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          theme = prefersDark ? 'coffee' : 'arepa';
          localStorage.setItem('jesszb-theme', theme);
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- GSAP -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer is:inline></script>

    <!-- Client Router for SPA-like navigation -->
    <ClientRouter />
  </head>

  <body class="min-h-screen bg-bg-deep">
    <!-- Theme curtain (must be first child for z-index stacking) -->
    <ThemeCurtain />
    <a href="#main" class="skip-link" data-i18n="a11y.skip">Saltar al contenido</a>

    <slot />

    <!-- i18n Engine — inlined translations to avoid fetch issues in static Astro -->
    <script is:inline define:vars={{ translations }}>
      (function () {
        var _translations = {
          es: JSON.parse(translations.es),
          en: JSON.parse(translations.en),
        };

        function flattenObj(obj, prefix) {
          return Object.entries(obj).reduce(function (acc, pair) {
            var key = pair[0];
            var val = pair[1];
            var fullKey = prefix ? prefix + '.' + key : key;
            if (typeof val === 'object' && val !== null && !Array.isArray(val)) {
              Object.assign(acc, flattenObj(val, fullKey));
            } else {
              acc[fullKey] = String(val);
            }
            return acc;
          }, {});
        }

        function detectLang() {
          var stored = localStorage.getItem('jesszb-lang');
          if (stored === 'es' || stored === 'en') return stored;
          var browser = navigator.language ? navigator.language.slice(0, 2).toLowerCase() : 'es';
          return browser === 'en' ? 'en' : 'es';
        }

        function getTheme() {
          return document.documentElement.getAttribute('data-theme') || 'arepa';
        }

        function applyTranslations(lang, theme) {
          var raw = _translations[lang] || _translations.es;
          var t = flattenObj(raw, '');

          // Standard keys
          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var key = el.getAttribute('data-i18n');
            if (t[key] !== undefined) el.innerHTML = t[key];
          });

          // Placeholder keys
          document.querySelectorAll('[data-i18n-placeholder]').forEach(function (el) {
            var key = el.getAttribute('data-i18n-placeholder');
            if (t[key] !== undefined) el.placeholder = t[key];
          });

          // Theme-aware keys
          document.querySelectorAll('[data-i18n-arepa]').forEach(function (el) {
            var keyArepa = el.getAttribute('data-i18n-arepa');
            var keyCoffee = el.getAttribute('data-i18n-coffee');
            var key = theme === 'coffee' ? keyCoffee : keyArepa;
            if (key && t[key] !== undefined) el.innerHTML = t[key];
          });

          // Direct dynamic texts (bypasses JSON, reads direct attribute)
          document.querySelectorAll('[data-i18n-text-es]').forEach(function (el) {
            var val = el.getAttribute('data-i18n-text-' + lang);
            if (val !== null) el.innerHTML = val;
          });

          // html lang attribute
          document.documentElement.setAttribute('lang', lang);
        }

        function updateLang(lang) {
          var activeLang = lang || detectLang();
          var theme = getTheme();
          localStorage.setItem('jesszb-lang', activeLang);
          document.documentElement.setAttribute('data-lang', activeLang);
          applyTranslations(activeLang, theme);

          // Sync lang toggle buttons
          document.querySelectorAll('[data-lang-label]').forEach(function (el) {
            el.setAttribute('aria-current', el.getAttribute('data-lang-label') === activeLang ? 'true' : 'false');
          });
        }

        function refreshThemeTexts() {
          var lang = detectLang();
          var theme = getTheme();
          var raw = _translations[lang] || _translations.es;
          var t = flattenObj(raw, '');
          document.querySelectorAll('[data-i18n-arepa]').forEach(function (el) {
            var keyArepa = el.getAttribute('data-i18n-arepa');
            var keyCoffee = el.getAttribute('data-i18n-coffee');
            var key = theme === 'coffee' ? keyCoffee : keyArepa;
            if (key && t[key] !== undefined) el.textContent = t[key];
          });
        }

        // Expose globally for ThemeToggle script
        window.refreshThemeTexts = refreshThemeTexts;
        window.updateLang = updateLang;

        // Listen for lang-change event from LangToggle
        window.addEventListener('jesszb:lang-change', function (e) {
          updateLang(e.detail.lang);
        });

        // Translate as soon as the DOM above is parsed, so the first paint is already in the
        // active language (avoids a late ES->EN reflow when GSAP/module scripts are slow).
        updateLang();
        var skipFirstPageLoad = true;

        // Auto-init on initial load AND after ClientRouter navigation
        document.addEventListener('astro:page-load', function () {
          if (skipFirstPageLoad) { skipFirstPageLoad = false; return; }
          updateLang();
        });
      })();
    </script>

    <!-- GSAP Scroll Reveals (IntersectionObserver: no measured positions, so zoom/resize/layout shift cannot break them) -->
    <script is:inline>
      var revealState = { observers: [], pending: [], timer: null, checkTimer: null };

      function revealItem(item) {
        if (item.done) return;
        item.done = true;
        if (item.io) item.io.unobserve(item.el);
        if (item.stagger) {
          gsap.to(item.el.children, { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, overwrite: 'auto' });
        } else {
          gsap.to(item.el, { opacity: 1, x: 0, y: 0, duration: 0.8, overwrite: 'auto' });
        }
      }

      // Reveal anything not below the viewport (visible or already scrolled past)
      function revealReachable() {
        revealState.pending.forEach(function (item) {
          if (!item.done && item.el.getBoundingClientRect().top < window.innerHeight) revealItem(item);
        });
      }

      function teardownReveals() {
        revealState.observers.forEach(function (io) { io.disconnect(); });
        revealState.observers = [];
        revealState.pending = [];
        clearTimeout(revealState.timer);
        window.__revealObservers = revealState.observers;
      }

      function initScrollAnimations() {
        teardownReveals();
        if (typeof gsap === 'undefined') return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;

        var defs = [
          { sel: '[data-animate]', from: { opacity: 0, y: 40 } },
          { sel: '[data-animate-left]', from: { opacity: 0, x: -60 } },
          { sel: '[data-animate-right]', from: { opacity: 0, x: 60 } },
          { sel: '[data-animate-stagger]', from: { opacity: 0, y: 30 }, stagger: true }
        ];

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var item = entry.target.__revealItem;
            if (!item || item.done) return;
            var limit = entry.rootBounds ? entry.rootBounds.bottom : window.innerHeight;
            if (entry.isIntersecting || entry.boundingClientRect.top < limit) revealItem(item);
          });
        }, { threshold: 0, rootMargin: '0px 0px -15% 0px' });
        revealState.observers.push(io);
        window.__revealObservers = revealState.observers;

        defs.forEach(function (def) {
          document.querySelectorAll(def.sel).forEach(function (el) {
            var item = { el: el, stagger: !!def.stagger, io: io, done: false };
            el.__revealItem = item;
            gsap.set(def.stagger ? el.children : el, def.from);
            revealState.pending.push(item);
            io.observe(el);
          });
        });

        // Belt and braces: reveal whatever is still hidden but reachable
        revealState.timer = setTimeout(revealReachable, 2500);
      }

      function scheduleRevealCheck() {
        clearTimeout(revealState.checkTimer);
        revealState.checkTimer = setTimeout(revealReachable, 150);
      }
      window.addEventListener('resize', scheduleRevealCheck);
      window.addEventListener('orientationchange', scheduleRevealCheck);
      if (window.visualViewport) window.visualViewport.addEventListener('resize', scheduleRevealCheck);

      // Drop the outgoing page's observers before the DOM is swapped
      document.addEventListener('astro:before-swap', teardownReveals);

      // gsap is loaded with defer: if it is not ready yet, wait for window load once
      document.addEventListener('astro:page-load', function () {
        if (typeof gsap !== 'undefined') {
          initScrollAnimations();
        } else if (document.readyState !== 'complete') {
          window.addEventListener('load', initScrollAnimations, { once: true });
        }
      });
    </script>
  </body>
</html>
