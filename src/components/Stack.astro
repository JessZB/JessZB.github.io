---
// Stack — main stack (with build-time proof), skills by domain, tool workbench.
// Merges the former Skills + Tools sections. Texts go through data-i18n.
import identity from '../data/identity.json';
import es from '../data/es';
import en from '../data/en';

// ─── Main stack + usage proof ─────────────────────────────────────
// Explicit, conservative alias map: raw `techs` value -> main-stack name.
// Only obvious equivalences (version suffixes, vanilla variants, MySQL/MariaDB).
const ALIASES: Record<string, string> = {
  'JavaScript': 'JavaScript (ES6+)',
  'Vanilla JS': 'JavaScript (ES6+)',
  'Node.js': 'Node.js',
  'React': 'React',
  'React 19': 'React',
  'Astro': 'Astro',
  'Astro 5': 'Astro',
  'TypeScript': 'TypeScript',
  'PHP': 'PHP',
  'Vanilla PHP': 'PHP',
  'MySQL': 'MySQL / MariaDB',
  'MariaDB': 'MySQL / MariaDB',
  'PostgreSQL': 'PostgreSQL',
};

const mainStack = [
  'JavaScript (ES6+)',
  'Node.js',
  'React',
  'Astro',
  'TypeScript',
  'PHP',
  'MySQL / MariaDB',
  'PostgreSQL',
];

// Skill items (as listed in identity.skills) that belong to the main stack.
const mainItems = new Set([
  'JavaScript (ES6+)',
  'TypeScript',
  'React',
  'Astro',
  'Node.js',
  'PHP (MVC)',
  'MySQL / MariaDB',
  'PostgreSQL',
]);

const projectCount: Record<string, number> = Object.fromEntries(mainStack.map((n) => [n, 0]));
for (const p of identity.projects) {
  const seen = new Set<string>();
  for (const t of p.techs as string[]) {
    const canon = ALIASES[t];
    if (canon) seen.add(canon);
  }
  seen.forEach((c) => (projectCount[c] += 1));
}

// Only show a figure when it is real evidence (2+ projects).
// Sorted by count (desc); ties keep the original order; no-figure entries go last.
const maxCount = Math.max(...Object.values(projectCount));
const stack = mainStack
  .map((name, i) => ({ name, i, n: projectCount[name], shown: projectCount[name] >= 2 }))
  .sort((a, b) => (Number(b.shown) - Number(a.shown)) || (b.shown ? b.n - a.n : 0) || a.i - b.i);
const ratio = (n: number) => (n / maxCount).toFixed(3);
// Asymmetric rhythm: 1 lead, 2 secondary, rest compact.
const tier = (idx: number) => (idx === 0 ? 'lead' : idx < 5 ? 'mid' : 'rest');

// ─── Domains ──────────────────────────────────────────────────────
type RawSkill = string | { es: string; en: string };
const toItems = (list: RawSkill[]) =>
  list.map((s) => (typeof s === 'string' ? { es: s, en: s } : s));

const domains = [
  { key: 'frontend', items: toItems(identity.skills.frontend) },
  { key: 'backend', items: toItems(identity.skills.backend) },
  { key: 'databases', items: toItems(identity.skills.databases) },
  { key: 'devops', items: toItems(identity.skills.devops) },
  { key: 'security', items: toItems(identity.skills.security) },
  { key: 'ai', items: toItems(identity.skills.ai) },
  { key: 'soft', items: toItems(identity.skills.soft) },
];

// ─── Workbench ────────────────────────────────────────────────────
interface Tool {
  name: string;
  typeKey: string;
  type: string;
  iconPath: string;
}

const base: Tool[] = [
  { name: 'VS Code', typeKey: 'editor', type: 'Editor', iconPath: 'M16.5 2L3 9l4 2.5L16.5 5l4 2.5-9.5 6L7 11 3 13.5 16.5 22l4-2.5V5L16.5 2Z' },
  { name: 'OpenCode', typeKey: 'aiCli', type: 'AI CLI', iconPath: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { name: 'Git', typeKey: 'versioning', type: 'Versionado', iconPath: 'M6 3v18M18 3v18M3 6h18M3 18h18' },
  { name: 'GitHub', typeKey: 'repos', type: 'Repositorios', iconPath: 'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4' },
];
const agents: Tool[] = [
  { name: 'Claude', typeKey: 'aiAgent', type: 'AI Agent', iconPath: 'M12 2v20M2 12h20M4.93 4.93l14.14 14.14M19.07 4.93 4.93 19.07' },
  { name: 'Codex', typeKey: 'aiAgent', type: 'AI Agent', iconPath: 'M4 17l6-6-6-6M12 19h8' },
  { name: 'Gemini CLI', typeKey: 'aiCli', type: 'AI CLI', iconPath: 'M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2Zm0 2c1.66 0 3.18.54 4.42 1.43L5.43 16.42A7.96 7.96 0 0 1 4 12c0-4.42 3.58-8 8-8Zm0 16c-1.66 0-3.18-.54-4.42-1.43L18.57 7.58A7.96 7.96 0 0 1 20 12c0 4.42-3.58 8-8 8Z' },
  { name: 'Antigravity', typeKey: 'cloudIde', type: 'Cloud IDE', iconPath: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547Z' },
];
const support: Tool[] = [
  { name: 'Prisma', typeKey: 'orm', type: 'ORM', iconPath: 'M4 22L12 2l8 20-8-4-8 4z' },
  { name: 'Insomnia', typeKey: 'apiTesting', type: 'API Testing', iconPath: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z' },
  { name: 'Obsidian', typeKey: 'notes', type: 'Notas', iconPath: 'M12 2l3.5 7h7l-5.5 4 2 7L12 16.5 5 20l2-7L1.5 9h7z' },
];
const groups = [
  { key: 'base', label: 'Desarrollo base', tools: base },
  { key: 'agents', label: 'Agentes y CLI de IA', tools: agents },
  { key: 'support', label: 'Apoyo', tools: support },
];
---

<section id="stack" class="relative overflow-hidden">
  <div class="section-container" data-animate>

    <h2 class="section-title text-center neon-line pb-4" data-i18n="stack.title">Stack</h2>
    <p
      class="section-subtitle text-center"
      data-i18n-arepa="stack.subtitle.arepa"
      data-i18n-coffee="stack.subtitle.coffee"
    >
      Tecnologías con las que he cocinado código
    </p>

    <div class="section-divider"></div>

    <!-- 1. Main stack: project counts as the graphic element -->
    <ul class="stack-main grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-12 lg:gap-x-10 mb-24 max-w-5xl mx-auto" data-animate-stagger>
      {stack.map((t, idx) => (
        <li class={`stack-item stack-${tier(idx)}`} style={`--ratio:${t.shown ? ratio(t.n) : 0}`}>
          <span class="stack-rule" aria-hidden="true"><span class="stack-rule-fill"></span></span>
          <div class="flex items-end gap-x-4 gap-y-1 pt-4">
            {t.shown && <span class="stack-num font-heading font-bold text-primary-text">{t.n}</span>}
            <p class="stack-name font-heading font-bold leading-tight text-text-primary">
              {t.name}
              {t.shown && (
                <span class="block mt-1 text-[0.9375rem] font-medium text-text-secondary" data-i18n="stack.projectsWord">proyectos</span>
              )}
            </p>
          </div>
        </li>
      ))}
    </ul>

    <!-- 2. Skills by domain: editorial list -->
    <div class="mb-24 max-w-5xl mx-auto">
      <h3 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-10" data-i18n="stack.domainsTitle">Habilidades por dominio</h3>
      <dl data-animate-stagger>
        {domains.map((d) => (
          <div class="domain-row grid gap-3 md:grid-cols-[15rem_1fr] md:gap-12 border-t border-text-primary/15 py-8">
            <dt class="font-heading text-2xl font-bold leading-tight text-text-primary">
              <span class="domain-mark" aria-hidden="true"></span>
              <span data-i18n={`stack.domains.${d.key}`}>{d.key}</span>
            </dt>
            <dd>
              <ul class="skill-run text-base leading-relaxed">
                {d.items.map((item) => (
                  <li
                    class={mainItems.has(item.es) ? 'skill-main font-semibold text-text-primary' : 'text-text-secondary'}
                    data-i18n-text-es={item.es}
                    data-i18n-text-en={item.en}
                  >{item.es}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- 3. Workbench -->
    <div class="max-w-5xl mx-auto">
      <h3 class="font-heading text-3xl md:text-4xl font-bold text-text-primary mb-10" data-i18n="stack.benchTitle">Banco de trabajo</h3>
      <div class="grid gap-12 md:grid-cols-3 md:gap-10" data-animate-stagger>
        {groups.map((g) => (
          <div>
            <h4 class="font-heading text-xl font-bold text-text-primary border-t border-text-primary/15 pt-5 mb-3" data-i18n={`stack.groups.${g.key}`}>{g.label}</h4>
            <ul>
              {g.tools.map((tool) => (
                <li class="flex items-center gap-4 min-h-[4.5rem] py-2">
                  <span class="tool-tile" aria-hidden="true">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d={tool.iconPath}/>
                    </svg>
                  </span>
                  <span class="min-w-0">
                    <span class="block font-heading text-lg font-semibold leading-tight text-text-primary">{tool.name}</span>
                    <span class="block mt-0.5 text-sm leading-tight text-text-muted" data-i18n={`stack.toolTypes.${tool.typeKey}`}>{tool.type}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .skill-run { display: flex; flex-wrap: wrap; gap: 0.35rem 1.5rem; }
  .skill-main { text-decoration: underline; text-decoration-color: var(--color-primary); text-decoration-thickness: 2px; text-underline-offset: 0.3em; }

  .domain-mark { display: block; width: 2.5rem; height: 3px; margin-bottom: 0.75rem; background: var(--color-primary); border-radius: 2px; transform-origin: left; }

  .tool-tile {
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;
    width: 3.25rem; height: 3.25rem; border-radius: 0.875rem;
    color: var(--color-primary-text);
    background: color-mix(in srgb, var(--color-primary) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 30%, transparent);
  }

  .stack-item { min-width: 0; }
  .stack-rule { display: block; height: 3px; border-radius: 2px; background: color-mix(in srgb, var(--color-text-primary) 12%, transparent); }
  .stack-rule-fill { display: block; height: 100%; border-radius: 2px; background: var(--color-primary); width: calc(var(--ratio, 0) * 100%); transform-origin: left; }
  .stack-num { line-height: 0.85; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stack-lead { grid-column: span 2 / span 2; }
  .stack-lead .stack-num { font-size: clamp(4.5rem, 10vw, 6rem); }
  .stack-mid .stack-num { font-size: clamp(3rem, 5vw, 4rem); }
  .stack-rest .stack-num { font-size: clamp(2.5rem, 4vw, 3rem); }
  .stack-lead .stack-name { font-size: clamp(1.75rem, 3.2vw, 2.5rem); }
  .stack-mid .stack-name { font-size: clamp(1.25rem, 2.2vw, 1.75rem); }
  .stack-rest .stack-name { font-size: 1.125rem; }
  @media (max-width: 479px) {
    .stack-item > div { flex-direction: column; align-items: flex-start; gap: 0.5rem; }
  }
  @media (min-width: 1024px) {
    .stack-lead { grid-column: span 6 / span 6; grid-row: span 2 / span 2; }
    .stack-lead > div { flex-direction: column; align-items: flex-start; gap: 1.25rem; padding-top: 1.5rem; }
    .stack-mid { grid-column: span 3 / span 3; }
    .stack-rest { grid-column: span 4 / span 4; }
  }
  /* Default state is fully drawn; JS opts into the draw-in animation. */
  .draw-ready .stack-rule-fill, .draw-ready .domain-mark { transform: scaleX(0); }
  .draw-ready .is-in .stack-rule-fill, .draw-ready .is-in .domain-mark { transform: scaleX(1); transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s; }
  .draw-ready .domain-row.is-in .domain-mark { transform: scaleX(1); transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s; }
</style>

<script>
  function initStackDraw() {
    const root = document.getElementById('stack');
    if (!root) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    root.classList.add('draw-ready');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.2 });
    root.querySelectorAll('.stack-item, .domain-row').forEach((el) => io.observe(el));
  }
  document.addEventListener('astro:page-load', initStackDraw);
</script>
