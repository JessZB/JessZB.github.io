---
// About — editorial layout (same language as Stack/Timeline): figures + links in a side column,
// bio as a lead statement followed by three short paragraphs. Texts go through data-i18n.
import identity from '../data/identity.json';

const social = identity.identity.social;
// Spanish fallback copy (the i18n engine swaps it for the active language)
const [bio2a, bio2b, bio2c] = identity.about.bio2_es.split(/(?<=\.)\s+/);
const links = [
  {
    name: 'GitHub',
    href: social.github,
    icon: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  },
  {
    name: 'LinkedIn',
    href: social.linkedin,
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  },
  {
    name: 'Twitter / X',
    href: social.twitter,
    icon: '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>',
  },
];
---

<section id="about" class="relative overflow-hidden">
  <div class="section-container" data-animate>

    <h2 class="section-title text-center neon-line pb-4" data-i18n="about.title">Sobre Mí</h2>
    <p class="section-subtitle text-center" data-i18n="about.subtitle">La historia detrás del código</p>

    <div class="section-divider"></div>

    <div class="max-w-5xl mx-auto grid gap-10 border-t border-text-primary/15 pt-8 md:pt-10 lg:grid-cols-[15rem_1fr] lg:gap-16">

      <!-- Figures + links -->
      <div class="flex flex-col gap-8">
        <dl class="grid grid-cols-2 gap-6 lg:grid-cols-1 lg:gap-8">
          <div class="flex flex-col">
            <dt class="order-2 mt-2 text-base font-medium leading-snug text-text-secondary" data-i18n="about.stats.years">Años de experiencia</dt>
            <dd class="order-1 about-num font-heading font-bold text-primary-text">{identity.about.years_of_experience}</dd>
          </div>
          <div class="flex flex-col">
            <dt class="order-2 mt-2 text-base font-medium leading-snug text-text-secondary" data-i18n="about.stats.projects">proyectos</dt>
            <dd class="order-1 about-num font-heading font-bold text-primary-text">{identity.projects.length}</dd>
          </div>
        </dl>

        <ul class="flex items-center gap-3">
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class="about-link inline-flex items-center justify-center w-11 h-11 rounded-full border border-text-primary/25 text-text-secondary"
                aria-label={l.name}
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon}></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Bio -->
      <div>
        <p
          class="font-heading text-xl md:text-2xl font-semibold leading-snug text-text-primary text-balance max-w-[34ch] md:max-w-[40ch]"
          data-i18n-arepa="about.bio.arepa"
          data-i18n-coffee="about.bio.coffee"
        >
          {identity.about.bio_arepa_es}
        </p>
        <div class="mt-8 max-w-[65ch] text-base leading-relaxed text-text-secondary">
          <p class="border-t border-text-primary/15 pt-5" data-i18n="about.bio2.p1">{bio2a}</p>
          <p class="mt-5 border-t border-text-primary/15 pt-5" data-i18n="about.bio2.p2">{bio2b}</p>
          <p class="mt-5 border-t border-text-primary/15 pt-5" data-i18n="about.bio2.p3">{bio2c}</p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .about-num { font-size: clamp(3.5rem, 8vw, 5rem); line-height: 0.9; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  @media (hover: hover) and (pointer: fine) {
    .about-link:hover { color: var(--color-primary-text); border-color: var(--color-primary); }
  }
  .about-link:active { color: var(--color-primary-text); border-color: var(--color-primary); scale: 0.92; }
  .about-link { transition: color 0.2s ease, border-color 0.2s ease, scale 0.12s ease-out; }
</style>
