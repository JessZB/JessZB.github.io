---
// ThemeToggle — switches between arepa (default) and coffee themes
---

<button
  id="theme-toggle"
  class="theme-toggle-btn"
  aria-label="Cambiar tema / Switch theme"
  title="Cambiar tema"
>
  <!-- Arepa icon (Light mode) -->
  <span id="theme-icon-arepa" class="theme-icon arepa-icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 100 60" fill="currentColor"><path d="M5 26 v8 a45 24 0 0 0 90 0 v-8z" opacity="0.6"/><ellipse cx="50" cy="26" rx="45" ry="24"/><path d="M14 30 Q20 16 40 14" stroke="#fff" stroke-width="6" stroke-linecap="round" fill="none" opacity="0.4"/><ellipse cx="68" cy="32" rx="12" ry="6" fill="#000" opacity="0.18"/><ellipse cx="34" cy="34" rx="8" ry="4" fill="#000" opacity="0.15"/></svg>
  </span>

  <!-- Toggle pill -->
  <span class="toggle-pill">
    <span class="toggle-knob"></span>
  </span>

  <!-- Coffee icon (Dark mode) -->
  <span id="theme-icon-coffee" class="theme-icon coffee-icon" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 100 60" fill="currentColor"><ellipse cx="50" cy="51" rx="46" ry="8" opacity="0.55"/><path d="M20 22 Q20 51 50 51 Q80 51 80 22z"/><ellipse cx="50" cy="22" rx="30" ry="9"/><ellipse cx="50" cy="23" rx="25" ry="6" fill="#000" opacity="0.5"/><path d="M80 26 Q99 26 94 38 Q90 46 76 44" stroke="currentColor" stroke-width="6" stroke-linecap="round" fill="none"/><path d="M28 30 Q30 44 40 48" stroke="#fff" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.35"/><path d="M40 14 Q36 8 40 3 M58 14 Q54 8 58 3" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" opacity="0.5"/></svg>
  </span>
</button>

<style>
  .theme-toggle-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: color-mix(in srgb, var(--color-text-primary) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 10%, transparent);
    border-radius: 9999px;
    padding: 0.3rem 0.6rem;
    cursor: pointer;
    transition: all 0.3s ease;
    color: var(--color-text-secondary);
    min-height: 44px;
  }

  @media (hover: hover) and (pointer: fine) {
    .theme-toggle-btn:hover {
      border-color: var(--color-primary);
      color: var(--color-primary-text);
      box-shadow: 0 0 10px rgba(var(--color-primary), 0.2); /* this works globally */
    }
  }

  .theme-toggle-btn:active {
    transform: scale(0.94);
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
  }

  .theme-icon {
    display: flex;
    align-items: center;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .toggle-pill {
    width: 2.2rem;
    height: 1.1rem;
    background: color-mix(in srgb, var(--color-text-primary) 10%, transparent);
    border-radius: 9999px;
    position: relative;
    border: 1px solid color-mix(in srgb, var(--color-text-primary) 15%, transparent);
    transition: background 0.3s ease;
  }

  .toggle-knob {
    position: absolute;
    top: 50%;
    left: 2px;
    transform: translateY(-50%);
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-primary);
    transition: left 0.3s ease, background 0.3s ease;
    box-shadow: 0 0 6px rgba(245, 197, 66, 0.5);
  }

  /* Active/Inactive Icon States */
  .arepa-icon {
    color: var(--color-primary);
    opacity: 1;
  }
  .coffee-icon {
    color: var(--color-text-secondary);
    opacity: 0.4;
  }

  :global([data-theme="coffee"]) .arepa-icon {
    color: var(--color-text-secondary);
    opacity: 0.4;
  }
  :global([data-theme="coffee"]) .coffee-icon {
    color: var(--color-primary);
    opacity: 1;
  }

  /* Coffee state knob */
  :global([data-theme="coffee"]) .toggle-knob {
    left: calc(100% - 14px);
    background: var(--color-primary);
    box-shadow: 0 0 6px rgba(200, 135, 74, 0.5);
  }

  :global([data-theme="coffee"]) .toggle-pill {
    background: rgba(200, 135, 74, 0.15);
  }
  /* Compact on phones: show only the active theme icon + pill */
  @media (max-width: 639px) {
    .theme-toggle-btn {
      gap: 0.375rem;
      padding: 0.3rem 0.55rem;
    }
    .theme-icon {
      display: none;
    }
    :global(html:not([data-theme="coffee"])) .arepa-icon,
    :global([data-theme="coffee"]) .coffee-icon {
      display: flex;
    }
  }
  /* Narrow phones: tighter pill so the navbar controls keep >= 8px between them */
  @media (max-width: 400px) {
    .theme-toggle-btn {
      gap: 0.25rem;
      padding: 0.3rem 0.4rem;
    }
  }
</style>

<script>
  let themeClickHandler: (() => void) | null = null;

  function initThemeToggle(): void {
    // Restore theme from localStorage after ClientRouter navigation
    const stored = localStorage.getItem('jesszb-theme');
    if (stored === 'coffee') {
      document.documentElement.setAttribute('data-theme', 'coffee');
    } else if (stored === 'arepa') {
      document.documentElement.setAttribute('data-theme', 'arepa');
    }

    const btn = document.getElementById('theme-toggle');
    const curtain = document.getElementById('theme-curtain');

    // Remove old listener before adding new one
    if (themeClickHandler) {
      btn?.removeEventListener('click', themeClickHandler);
    }

    function switchTheme(): void {
      const current = document.documentElement.getAttribute('data-theme') || 'arepa';
      const next = current === 'arepa' ? 'coffee' : 'arepa';

      if (curtain) {
        curtain.setAttribute('data-target-theme', next);
        curtain.classList.add('curtain-active');

        setTimeout(() => {
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('jesszb-theme', next);

          if (typeof (window as any).refreshThemeTexts === 'function') {
            (window as any).refreshThemeTexts();
          }

          setTimeout(() => {
            curtain.classList.add('curtain-leaving');
            curtain.classList.remove('curtain-active');
            
            setTimeout(() => {
              curtain.classList.remove('curtain-leaving');
            }, 500);
          }, 600);
        }, 900);
      } else {
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('jesszb-theme', next);
      }
    }

    themeClickHandler = switchTheme;
    btn?.addEventListener('click', themeClickHandler);
  }

  document.addEventListener('astro:page-load', initThemeToggle);
</script>
