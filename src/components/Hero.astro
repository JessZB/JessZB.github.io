---
// Hero — greeting, name, role, typing line and CTAs (the bio lives in About.astro)
// Uses data-i18n and data-i18n-arepa/coffee for theme-aware texts
---

<section id="hero" class="relative min-h-[100svh] flex items-center justify-center overflow-hidden bg-bg-deep bg-grid">

  <!-- Ambient blobs -->
  <div class="absolute inset-0 pointer-events-none [contain:layout_paint]" aria-hidden="true">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[120px] animate-float"></div>
    <div class="absolute top-[calc(100svh-24rem)] right-1/4 w-96 h-96 bg-secondary/10 rounded-full blur-[120px] animate-float" style="animation-delay: 2s;"></div>
    <div class="absolute top-[calc(50svh-250px)] left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-highlight/5 rounded-full blur-[150px]"></div>
  </div>

  <!-- Particles -->
  <div id="particles-container" class="absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <!-- Main content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto pt-20 sm:pt-24 pb-24">

    <!-- Avatar / Hero icon — theme-aware -->
    <div class="mb-5 sm:mb-8 inline-block" aria-hidden="true">
      <div id="hero-icon-arepa" class="hero-icon">
        <!-- Arepa SVG -->
        <svg width="110" height="110" viewBox="0 0 100 100" class="mx-auto w-20 h-20 sm:w-[110px] sm:h-[110px] animate-float drop-shadow-[0_0_24px_rgba(245,197,66,0.45)]">
          <!-- Steam -->
          <path d="M38 15 Q34 9 38 4 M52 15 Q48 9 52 4 M66 15 Q62 9 66 4" stroke="#C98A1A" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.4"/>
          <!-- Ground shadow -->
          <ellipse cx="50" cy="93" rx="34" ry="4" fill="#8A5A00" opacity="0.2"/>
          <!-- Edge (canto) -->
          <path d="M10 54 v10 a40 30 0 0 0 80 0 v-10 z" fill="#B8761A"/>
          <path d="M14 70 Q50 100 86 70" stroke="#8A5A00" stroke-width="2" fill="none" opacity="0.35" stroke-linecap="round"/>
          <!-- Top face -->
          <ellipse cx="50" cy="54" rx="40" ry="30" fill="#F5A623" stroke="#C98A1A" stroke-width="2"/>
          <ellipse cx="50" cy="54" rx="33" ry="23" fill="#F9B53C"/>
          <!-- Budare toast spots -->
          <path d="M22 56 Q26 46 36 48 Q42 54 34 62 Q25 64 22 56Z" fill="#C98A1A" opacity="0.55"/>
          <path d="M58 62 Q66 54 76 58 Q80 66 70 70 Q60 70 58 62Z" fill="#C98A1A" opacity="0.55"/>
          <path d="M52 40 Q60 36 66 42 Q62 47 54 46Z" fill="#C98A1A" opacity="0.45"/>
          <ellipse cx="45" cy="66" rx="6" ry="3" fill="#8A5A00" opacity="0.3"/>
          <circle cx="72" cy="47" r="2.5" fill="#8A5A00" opacity="0.35"/>
          <circle cx="30" cy="40" r="2" fill="#8A5A00" opacity="0.3"/>
          <!-- Highlight -->
          <path d="M20 50 Q26 34 44 31" stroke="#FFD27A" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.85"/>
          <ellipse cx="50" cy="35" rx="7" ry="2" fill="#FFD27A" opacity="0.55"/>
        </svg>
      </div>
      <div id="hero-icon-coffee" class="hero-icon hidden">
        <!-- Coffee cup SVG -->
        <svg width="110" height="110" viewBox="0 0 100 100" class="mx-auto w-20 h-20 sm:w-[110px] sm:h-[110px] animate-float drop-shadow-[0_0_24px_rgba(200,135,74,0.45)]">
          <path d="M34 24 Q29 17 34 10 Q38 4 34 -1 M47 24 Q42 17 47 10 Q51 4 47 -1 M60 24 Q55 17 60 10 Q64 4 60 -1" stroke="#C9B89A" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.45"/>
          <ellipse cx="46" cy="92" rx="38" ry="3.5" fill="#000" opacity="0.35"/>
          <ellipse cx="46" cy="83" rx="40" ry="8" fill="#8F5A2A"/>
          <ellipse cx="46" cy="80" rx="40" ry="8" fill="#D49558"/>
          <ellipse cx="46" cy="79" rx="26" ry="5" fill="#B87438"/>
          <path d="M72 44 Q94 40 90 56 Q86 68 68 66" stroke="#8F5A2A" stroke-width="7" stroke-linecap="round" fill="none"/>
          <path d="M72 44 Q94 40 90 56 Q86 68 68 66" stroke="#C8874A" stroke-width="4" stroke-linecap="round" fill="none"/>
          <path d="M18 38 Q18 79 46 79 Q74 79 74 38 Z" fill="#C8874A"/>
          <path d="M64 46 Q64 70 46 76 Q70 76 74 38 Z" fill="#8F5A2A" opacity="0.45"/>
          <ellipse cx="46" cy="38" rx="28" ry="9" fill="#E8A96B"/>
          <ellipse cx="46" cy="39" rx="24" ry="7" fill="#3B2416"/>
          <ellipse cx="42" cy="38" rx="13" ry="3.5" fill="#8B5A2B" opacity="0.7"/>
          <path d="M25 46 Q27 66 38 73" stroke="#F5EBD8" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.5"/>
          <path d="M30 33 Q40 29 52 30" stroke="#F5EBD8" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5"/>
        </svg>
      </div>
    </div>

    <!-- Badge -->
    <div class="mb-5 sm:mb-6 inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-bg-surface border border-primary/30 shadow-sm text-sm font-heading font-medium text-text-primary hover:border-primary transition-colors">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-secondary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-secondary"></span>
      </span>
      <span data-i18n="hero.badge">Disponible para proyectos · UTC-4 (VE)</span>
    </div>

    <!-- Greeting + Name -->
    <div class="mb-2">
      <p class="text-text-muted font-body text-lg mb-1" data-i18n="hero.greeting">Hola, soy Jesús Zapata</p>
      <h1 class="font-heading text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold">
        <span class="glow-text">JESSZB</span><span class="text-accent-text">.</span><span class="glow-text">DEV</span>
      </h1>
    </div>

    <!-- Role -->
    <p class="font-heading text-base sm:text-2xl text-text-secondary mb-2 tracking-wider sm:tracking-widest uppercase text-balance" data-i18n="hero.role">
      Full-Stack Developer
    </p>

    <!-- Typing subtitle — theme-aware -->
    <div class="inline-block mb-8 sm:mb-10 min-h-[3.5rem] md:min-h-[2rem]">
      <p
        id="typing-text"
        class="font-heading text-base sm:text-lg md:text-xl text-secondary-text font-medium"
        aria-hidden="true"
      ></p>
      <!-- Full subtitle for assistive tech: the typed copy above is rewritten character by character -->
      <span id="typing-sr" class="sr-only"></span>
    </div>

    <!-- CTAs -->
    <div class="flex flex-row flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a href="#projects" id="cta-projects" class="btn-primary text-base px-5 sm:px-8 py-3 sm:py-3.5 min-h-[48px] flex items-center gap-2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        <span data-i18n="hero.cta1">Ver Proyectos</span>
      </a>
      <a href="#contact" id="cta-contact" class="btn-outline text-base px-5 sm:px-8 py-3 sm:py-3.5 min-h-[48px] flex items-center gap-2">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span data-i18n="hero.cta2">Contactar</span>
      </a>
    </div>
  </div>

  <!-- Scroll hint (static) -->
  <div class="absolute bottom-4 left-1/2 -translate-x-1/2">
    <a href="#about" class="flex items-center justify-center w-11 h-11 text-text-muted hover:text-primary-text active:text-primary-text active:scale-90 transition-colors" aria-label="Bajar" data-aria-es="Bajar" data-aria-en="Scroll down">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
    </a>
  </div>
</section>

<style>
  .hero-icon {
    transition: opacity 0.5s ease;
  }

  .hero-icon.hidden {
    display: none;
  }
</style>

<script>
  import '../scripts/aria-lang';

  const prefersReducedMotion = (): boolean => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Theme-aware hero icon swap
  function syncHeroIcon(): void {
    const theme = document.documentElement.getAttribute('data-theme') || 'arepa';
    const arepaIcon = document.getElementById('hero-icon-arepa');
    const coffeeIcon = document.getElementById('hero-icon-coffee');
    if (theme === 'coffee') {
      arepaIcon?.classList.add('hidden');
      coffeeIcon?.classList.remove('hidden');
    } else {
      arepaIcon?.classList.remove('hidden');
      coffeeIcon?.classList.add('hidden');
    }
  }

  // Typing animation — reads from i18n engine
  let currentTypingSession = 0;

  function startTyping(): void {
    const typingEl = document.getElementById('typing-text');
    if (!typingEl) return;

    const theme = document.documentElement.getAttribute('data-theme') || 'arepa';
    const lang = document.documentElement.getAttribute('data-lang') || 'es';

    const subtitles: Record<string, Record<string, string>> = {
      es: {
        arepa: '> Construyendo capas de software, como una buena arepa_',
        coffee: '> Código que despierta, como el primer café del día_',
      },
      en: {
        arepa: '> Building software layers, like a perfect arepa_',
        coffee: '> Code that wakes you up, like the first coffee of the day_',
      },
    };

    const subtitle = subtitles[lang]?.[theme] || subtitles.es.arepa;
    let i = 0;
    typingEl.textContent = '';

    const srEl = document.getElementById('typing-sr');
    if (srEl) srEl.textContent = subtitle.replace(/^>\s*/, '').replace(/_$/, '');

    // Reduced motion: show the full line at once, no typing
    if (prefersReducedMotion()) {
      currentTypingSession++;
      typingEl.textContent = subtitle;
      return;
    }

    currentTypingSession++;
    const sessionId = currentTypingSession;

    function type(): void {
      if (sessionId !== currentTypingSession) return;
      if (i < subtitle.length) {
        typingEl!.textContent = subtitle.substring(0, i + 1);
        i++;
        setTimeout(type, 60 + Math.random() * 40);
      }
    }

    setTimeout(type, 600);
  }

  // Particles
  function createParticles(): void {
    const colors = ['#F5C542', '#E74C3C', '#16A085', '#9B59B6', '#FFD966', '#1ABC9C', '#FF6B6B', '#BB8FCE'];
    const coffeeColors = ['#C8874A', '#A0404A', '#7BAE8C', '#8B6B8B', '#E8A96B', '#C4606A', '#9DC9AB', '#AA8DAA'];
    const container = document.getElementById('particles-container');
    if (!container) return;

    const theme = document.documentElement.getAttribute('data-theme') || 'arepa';
    const palette = theme === 'coffee' ? coffeeColors : colors;

    container.innerHTML = '';
    if (prefersReducedMotion()) return;
    for (let i = 0; i < 18; i++) {
      const particle = document.createElement('div');
      particle.classList.add('particle');
      const size = Math.random() * 4 + 2;
      particle.style.cssText = `
        position: absolute;
        border-radius: 50%;
        width: ${size}px;
        height: ${size}px;
        background: ${palette[Math.floor(Math.random() * palette.length)]};
        left: ${Math.random() * 100}%;
        top: ${Math.random() * 100}%;
        opacity: ${Math.random() * 0.5 + 0.1};
        box-shadow: 0 0 ${size * 2}px currentColor;
        animation: float ${Math.random() * 6 + 4}s ease-in-out ${Math.random() * 6}s infinite;
        pointer-events: none;
      `;
      container.appendChild(particle);
    }
  }

  // MutationObserver for theme/lang changes on <html>
  let themeLangObserver: MutationObserver | null = null;

  function initHero(): void {
    // Guard: skip if hero elements don't exist (page-specific component)
    if (!document.getElementById('typing-text')) return;

    // Disconnect existing observer before re-creating
    if (themeLangObserver) {
      themeLangObserver.disconnect();
      themeLangObserver = null;
    }

    syncHeroIcon();
    createParticles();
    startTyping();

    const htmlEl = document.documentElement;
    themeLangObserver = new MutationObserver((mutations) => {
      let shouldRetype = false;
      mutations.forEach(mutation => {
        if (mutation.attributeName === 'data-theme') {
          syncHeroIcon();
          createParticles();
          shouldRetype = true;
        }
        if (mutation.attributeName === 'data-lang') {
          shouldRetype = true;
        }
      });

      if (shouldRetype) {
        const typingEl = document.getElementById('typing-text');
        if (typingEl) {
          typingEl.textContent = '';
          startTyping();
        }
      }
    });
    themeLangObserver.observe(htmlEl, { attributes: true, attributeFilter: ['data-theme', 'data-lang'] });
  }

  document.addEventListener('astro:page-load', initHero);
</script>
