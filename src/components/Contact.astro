---
// Contact — theme-aware terminal header + mailto CTA with pre-filled subject/body (no external form service)
import identity from '../data/identity.json';
import es from '../data/es';
import en from '../data/en';

const email = identity.identity.email;
---

<section id="contact" class="section-dark relative overflow-hidden">
  <div class="section-container" data-animate>

    <h2 class="section-title text-center neon-line pb-4" data-i18n="contact.title">Contacto</h2>
    <p class="section-subtitle text-center" data-i18n="contact.subtitle">¿Hablamos?</p>

    <div class="section-divider"></div>

    <div class="max-w-2xl mx-auto">
      <div class="card-base p-6 sm:p-8 border-primary/10">

        <!-- Terminal header — theme-aware -->
        <div class="relative mb-8 px-4 pb-4 pt-8 bg-bg-deep rounded-lg border border-primary/10 font-mono text-sm text-text-muted overflow-hidden">
          <!-- Traffic lights + title bar -->
          <div class="absolute top-0 left-0 right-0 h-7 bg-bg-surface/80 flex items-center gap-1.5 px-3 rounded-t-lg">
            <span class="w-2.5 h-2.5 rounded-full bg-accent hover:opacity-80 transition-opacity cursor-default"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-primary hover:opacity-80 transition-opacity cursor-default"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-secondary hover:opacity-80 transition-opacity cursor-default"></span>
            <span class="text-xs text-text-muted ml-2 font-mono" id="terminal-title">terminal.exe</span>
          </div>

          <!-- Terminal lines -->
          <div class="space-y-1">
            <p>
              <span id="terminal-user" class="text-secondary-text" data-i18n-arepa="contact.terminal.arepa" data-i18n-coffee="contact.terminal.coffee">arepa@jesszb.dev</span>
              <span class="text-text-muted">:</span>
              <span class="text-highlight-light-text">~</span>
              <span class="text-text-primary">$ </span>
              <span id="terminal-cmd" data-i18n-arepa="contact.init.arepa" data-i18n-coffee="contact.init.coffee">iniciar_contacto.sh</span>
            </p>
            <p class="text-text-muted" id="terminal-msg" data-i18n-arepa="contact.initMessage.arepa" data-i18n-coffee="contact.initMessage.coffee">
              Inicializando protocolo de comunicación...
            </p>
            <p class="text-secondary-text flex items-center gap-1">
              <span class="terminal-cursor inline-block w-2 h-4 bg-current animate-pulse rounded-sm"></span>
            </p>
          </div>
        </div>

        <!-- Email CTA: mailto with pre-filled subject/body (set per language in the script) -->
        <div class="text-center">
          <a
            id="contact-mailto"
            href={`mailto:${email}`}
            data-subject-es={es.contact.mailSubject}
            data-subject-en={en.contact.mailSubject}
            data-body-es={es.contact.mailBody}
            data-body-en={en.contact.mailBody}
            class="btn-primary w-full sm:w-auto justify-center text-base py-3.5 px-8 inline-flex items-center gap-2"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span data-i18n="contact.cta">Escríbeme un correo</span>
          </a>
          <p class="text-text-muted text-sm mt-4" data-i18n="contact.ctaHint">Se abrirá tu aplicación de correo con el asunto ya escrito.</p>
          <a
            id="contact-gmail"
            href={`https://mail.google.com/mail/?view=cm&fs=1&to=${email}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center min-h-[44px] mt-2 px-3 text-sm text-secondary-text hover:text-primary-text active:text-primary-text underline underline-offset-4 transition-colors"
            data-i18n="contact.ctaGmail"
          >Abrir en Gmail</a>
          <p class="text-text-muted text-sm mt-4" data-i18n="contact.orWrite">O puedes escribirme a este correo:</p>
          <p class="mt-1 font-mono text-sm text-secondary-text select-all break-all">{email}</p>
        </div>

      </div>

      <!-- Social links -->
      <div class="mt-10 text-center">
        <p class="text-text-muted text-sm mb-4" data-i18n="contact.alt">O encontrame en:</p>
        <div class="flex flex-wrap justify-center gap-x-4 gap-y-2 sm:gap-6">
          <a href={`mailto:${identity.identity.email}`} class="social-link" aria-label="Email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <span class="text-sm">Email</span>
          </a>
          <a href={identity.identity.social.github} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            <span class="text-sm">GitHub</span>
          </a>
          <a href={identity.identity.social.linkedin} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            <span class="text-sm">LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Ambient -->
  <div class="absolute -top-20 right-0 w-72 h-72 bg-primary/5 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-20 left-0 w-72 h-72 bg-secondary/5 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
</section>

<style>
  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.5rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease, translate 0.2s ease, scale 0.12s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      color: var(--color-primary-text);
      translate: 0 -2px;
    }
  }

  .social-link:active {
    color: var(--color-primary-text);
    scale: 0.94;
  }
</style>

<script>
  let langObserver: MutationObserver | null = null;
  let themeObserver: MutationObserver | null = null;

  function updateMailto(): void {
    const link = document.getElementById('contact-mailto') as HTMLAnchorElement | null;
    if (!link) return;
    const en = document.documentElement.getAttribute('data-lang') === 'en';
    const subject = en ? link.dataset.subjectEn : link.dataset.subjectEs;
    const body = en ? link.dataset.bodyEn : link.dataset.bodyEs;
    const email = link.href.replace(/^mailto:/, '').split('?')[0];
    // CRLF line breaks are what mail clients expect inside a mailto body
    const enc = (s: string) => encodeURIComponent(s).replace(/%0A/g, '%0D%0A');
    link.href = `mailto:${email}?subject=${enc(subject ?? '')}&body=${enc(body ?? '')}`;

    // Gmail web compose: same pre-filled message, no mail app required
    const gmail = document.getElementById('contact-gmail') as HTMLAnchorElement | null;
    if (gmail) {
      gmail.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(subject ?? '')}&body=${encodeURIComponent(body ?? '')}`;
    }
  }

  function updateTerminalTheme(): void {
    const theme = document.documentElement.getAttribute('data-theme') || 'arepa';
    const title = document.getElementById('terminal-title');
    if (title) title.textContent = theme === 'coffee' ? 'coffee-shop.sh' : 'terminal.exe';
  }

  function initContact(): void {
    updateMailto();
    updateTerminalTheme();

    // Disconnect existing observers before re-creating (ClientRouter re-runs page-load)
    langObserver?.disconnect();
    themeObserver?.disconnect();

    langObserver = new MutationObserver(updateMailto);
    langObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
    themeObserver = new MutationObserver(updateTerminalTheme);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }

  document.addEventListener('astro:page-load', initContact);
</script>
