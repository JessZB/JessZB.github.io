---
// Contact — closing of the portfolio. One main route (email, with the reason chosen first),
// copyable address, Gmail web as fallback, GitHub/LinkedIn as secondary destinations.
// No form service: mailto / Gmail links are built from per-intent subject + body (ES/EN).
import identity from '../data/identity.json';
import es from '../data/es';
import en from '../data/en';

const email = identity.identity.email;
const { github, linkedin } = identity.identity.social;
const readable = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const intentKeys = ['job', 'project', 'other'] as const;
const intents = intentKeys.map((key) => ({
  key,
  subjectEs: es.contact.intents[key].subject,
  bodyEs: es.contact.intents[key].body,
  subjectEn: en.contact.intents[key].subject,
  bodyEn: en.contact.intents[key].body,
}));
// No-JS baseline: the first intent in Spanish, so the links work without scripts.
const enc = (s: string) => encodeURIComponent(s).replace(/%0A/g, '%0D%0A');
const base = intents[0];
const baseMailto = `mailto:${email}?subject=${enc(base.subjectEs)}&body=${enc(base.bodyEs)}`;
const baseGmail = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(base.subjectEs)}&body=${encodeURIComponent(base.bodyEs)}`;
---

<section id="contact" class="section-dark relative overflow-hidden">
  <div class="section-container" data-animate>

    <h2 class="section-title text-center neon-line pb-4" data-i18n="contact.title">Contacto</h2>
    <p class="section-subtitle text-center" data-i18n="contact.subtitle">¿Hablamos?</p>

    <div class="section-divider"></div>

    <div class="contact-grid max-w-5xl mx-auto grid gap-12 lg:grid-cols-12 lg:gap-16">

      <!-- Main route: pick the reason, then write -->
      <div class="lg:col-span-7 lg:col-start-6 lg:row-start-1">
        <fieldset class="contact-intents">
          <legend class="font-heading text-base font-semibold text-text-secondary mb-3" data-i18n="contact.legend">
            ¿Sobre qué quieres escribirme?
          </legend>
          <div class="grid gap-3">
            {intents.map((it, idx) => (
              <label class="contact-intent">
                <input
                  type="radio"
                  name="contact-intent"
                  value={it.key}
                  checked={idx === 0}
                  data-subject-es={it.subjectEs}
                  data-subject-en={it.subjectEn}
                  data-body-es={it.bodyEs}
                  data-body-en={it.bodyEn}
                />
                <span class="contact-intent-text">
                  <span class="contact-intent-label" data-i18n={`contact.intents.${it.key}.label`}>{es.contact.intents[it.key].label}</span>
                  <span class="contact-intent-desc" data-i18n={`contact.intents.${it.key}.desc`}>{es.contact.intents[it.key].desc}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <a
          id="contact-mailto"
          href={baseMailto}
          class="btn-primary mt-6 w-full justify-center text-lg py-4 px-8 min-h-[56px]"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <span data-i18n="contact.cta">Escribir por correo</span>
        </a>

        <a
          id="contact-gmail"
          href={baseGmail}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-gmail"
          data-i18n="contact.ctaGmail"
        >¿Sin app de correo? Abrir en Gmail</a>

        <!-- The address appears once: selectable text + copy button -->
        <div class="contact-address">
          <p class="contact-address-label" data-i18n="contact.emailLabel">Correo</p>
          <div class="contact-address-row">
            <span id="contact-email" class="contact-email">{email}</span>
            <button
              type="button"
              id="contact-copy"
              class="contact-copy"
              data-label-es={es.contact.copy}
              data-label-en={en.contact.copy}
              data-done-es={es.contact.copied}
              data-done-en={en.contact.copied}
              data-status-es={es.contact.copiedStatus}
              data-status-en={en.contact.copiedStatus}
              data-manual-es={es.contact.copyManual}
              data-manual-en={en.contact.copyManual}
            >
              <svg class="icon-copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
              <svg class="icon-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" hidden><path d="M20 6 9 17l-5-5"/></svg>
              <span class="contact-copy-label" data-i18n="contact.copy">Copiar correo</span>
            </button>
          </div>
          <p id="contact-copy-status" class="contact-copy-status" role="status" aria-live="polite"></p>
        </div>
      </div>
      <!-- Context: what I look for, availability, languages -->
      <div class="lg:col-span-5 lg:col-start-1 lg:row-start-1">
        <p class="hidden lg:block font-heading text-xl md:text-2xl font-semibold leading-snug text-text-primary text-balance" data-i18n="contact.lead">
          Elige el motivo y se abre un correo con el asunto ya escrito.
        </p>

        <dl class="contact-facts mt-8">
          <div>
            <dt data-i18n="contact.lookingLabel">Busco</dt>
            <dd data-i18n="contact.looking">Puestos de IT, soporte técnico y análisis de sistemas. También desarrollo full stack.</dd>
          </div>
          <div>
            <dt data-i18n="contact.availLabel">Disponibilidad</dt>
            <dd data-i18n="hero.badge">Disponible para proyectos · UTC-4 (VE)</dd>
          </div>
          <div>
            <dt data-i18n="contact.langLabel">Idiomas</dt>
            <dd data-i18n="contact.langs">Español · Inglés B1 (certificado EF SET)</dd>
          </div>
        </dl>
      </div>

    </div>

    <!-- Secondary destinations -->
    <div class="max-w-5xl mx-auto mt-16 pt-8 contact-secondary">
      <p class="font-heading text-base font-semibold text-text-secondary mb-4" data-i18n="contact.alt">Mi código y mi trayectoria</p>
      <div class="grid gap-3 sm:grid-cols-2">
        <a href={github} target="_blank" rel="noopener noreferrer" class="social-link">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span class="social-text">
            <span class="social-name">GitHub</span>
            <span class="social-url">{readable(github)}</span>
          </span>
        </a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="social-link">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          <span class="social-text">
            <span class="social-name">LinkedIn</span>
            <span class="social-url">{readable(linkedin)}</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Facts: label + value, separated by hairlines (same editorial language as Stack) */
  .contact-facts > div {
    padding: 1rem 0;
    border-top: 1px solid color-mix(in srgb, var(--color-primary-text) 28%, transparent);
  }
  .contact-facts dt {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary-text);
    margin-bottom: 0.25rem;
  }
  .contact-facts dd {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-primary);
  }

  /* Intent options: native radios inside large labels */
  .contact-intents {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .contact-intent {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    min-height: 56px;
    padding: 0.875rem 1rem;
    border: 1.5px solid color-mix(in srgb, var(--color-text-muted) 45%, transparent);
    border-radius: 0.75rem;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, scale 0.12s ease-out;
  }
  .contact-intent input {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.1rem;
    accent-color: var(--color-primary-text);
    cursor: pointer;
  }
  .contact-intent:has(input:checked) {
    border-color: var(--color-primary-text);
    background: var(--color-bg-surface);
  }
  .contact-intent:has(input:focus-visible) {
    outline: 3px solid var(--color-primary-text);
    outline-offset: 3px;
  }
  .contact-intent:active {
    scale: 0.985;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-intent:hover {
      border-color: var(--color-primary-text);
    }
  }
  .contact-intent-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }
  .contact-intent-label {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .contact-intent-desc {
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
  }

  /* Main CTA: dark-on-gold label comes from .btn-primary; add a visible, AA focus ring */
  #contact-mailto:focus-visible {
    outline: 3px solid var(--color-primary-text);
    outline-offset: 3px;
  }

  .contact-gmail {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.5rem;
    padding: 0 0.25rem;
    font-size: 0.9375rem;
    color: var(--color-secondary-text);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease, scale 0.12s ease-out;
  }
  .contact-gmail:active {
    color: var(--color-primary-text);
    scale: 0.97;
  }
  .contact-gmail:focus-visible,
  .contact-copy:focus-visible,
  .social-link:focus-visible {
    outline: 3px solid var(--color-primary-text);
    outline-offset: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-gmail:hover {
      color: var(--color-primary-text);
    }
  }

  /* Address + copy */
  .contact-address {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-primary-text) 28%, transparent);
  }
  .contact-address-label {
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 0.25rem;
  }
  .contact-address-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .contact-email {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1rem;
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
    user-select: all;
  }
  .contact-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text-primary);
    background: transparent;
    border: 1.5px solid var(--color-primary-text);
    border-radius: 9999px;
    cursor: pointer;
    transition: background-color 0.2s ease, scale 0.12s ease-out;
  }
  .contact-copy:active {
    scale: 0.95;
    background: color-mix(in srgb, var(--color-primary-text) 14%, transparent);
  }
  .contact-copy[data-state="done"] {
    background: color-mix(in srgb, var(--color-secondary-text) 14%, transparent);
    border-color: var(--color-secondary-text);
  }
  @media (hover: hover) and (pointer: fine) {
    .contact-copy:hover {
      background: color-mix(in srgb, var(--color-primary-text) 10%, transparent);
    }
  }
  .contact-copy-status {
    min-height: 1.5rem;
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-secondary-text);
  }

  /* Secondary destinations */
  .contact-secondary {
    border-top: 1px solid color-mix(in srgb, var(--color-primary-text) 28%, transparent);
  }
  .social-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 64px;
    padding: 0.75rem 1.25rem;
    color: var(--color-text-primary);
    text-decoration: none;
    border: 1.5px solid color-mix(in srgb, var(--color-text-muted) 45%, transparent);
    border-radius: 0.75rem;
    transition: border-color 0.2s ease, translate 0.2s ease, scale 0.12s ease-out;
  }
  .social-link svg {
    flex: none;
    color: var(--color-primary-text);
  }
  .social-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .social-name {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .social-url {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    overflow-wrap: anywhere;
  }
  @media (hover: hover) and (pointer: fine) {
    .social-link:hover {
      border-color: var(--color-primary-text);
      translate: 0 -2px;
    }
  }
  .social-link:active {
    border-color: var(--color-primary-text);
    scale: 0.97;
  }
</style>

<script>
  let langObserver: MutationObserver | null = null;
  let resetTimer: number | undefined;

  const isEn = () => document.documentElement.getAttribute('data-lang') === 'en';

  // CRLF line breaks are what mail clients expect inside a mailto body
  const enc = (s: string) => encodeURIComponent(s).replace(/%0A/g, '%0D%0A');

  function updateLinks(): void {
    const checked = document.querySelector<HTMLInputElement>('input[name="contact-intent"]:checked');
    const mailto = document.getElementById('contact-mailto') as HTMLAnchorElement | null;
    const gmail = document.getElementById('contact-gmail') as HTMLAnchorElement | null;
    const emailEl = document.getElementById('contact-email');
    if (!checked || !mailto || !emailEl) return;

    const subject = (isEn() ? checked.dataset.subjectEn : checked.dataset.subjectEs) ?? '';
    const body = (isEn() ? checked.dataset.bodyEn : checked.dataset.bodyEs) ?? '';
    const email = (emailEl.textContent ?? '').trim();

    mailto.href = `mailto:${email}?subject=${enc(subject)}&body=${enc(body)}`;
    // Gmail web compose: same pre-filled message, no mail app required
    if (gmail) {
      gmail.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(email)}&su=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }
  }

  function setCopyLabel(done: boolean): void {
    const btn = document.getElementById('contact-copy') as HTMLButtonElement | null;
    if (!btn) return;
    const lang = isEn() ? 'En' : 'Es';
    const label = btn.querySelector('.contact-copy-label');
    // Remove data-i18n while showing "Copied" so a language refresh does not overwrite it
    if (done) {
      label?.removeAttribute('data-i18n');
      if (label) label.textContent = btn.dataset[`done${lang}`] ?? '';
      btn.dataset.state = 'done';
    } else {
      label?.setAttribute('data-i18n', 'contact.copy');
      if (label) label.textContent = btn.dataset[`label${lang}`] ?? '';
      delete btn.dataset.state;
    }
    btn.querySelector('.icon-copy')?.toggleAttribute('hidden', done);
    btn.querySelector('.icon-check')?.toggleAttribute('hidden', !done);
  }

  function selectEmail(): void {
    const el = document.getElementById('contact-email');
    const sel = window.getSelection();
    if (!el || !sel) return;
    const range = document.createRange();
    range.selectNodeContents(el);
    sel.removeAllRanges();
    sel.addRange(range);
  }

  async function copyEmail(): Promise<void> {
    const btn = document.getElementById('contact-copy') as HTMLButtonElement | null;
    const status = document.getElementById('contact-copy-status');
    const emailEl = document.getElementById('contact-email');
    if (!btn || !status || !emailEl) return;
    const lang = isEn() ? 'En' : 'Es';
    window.clearTimeout(resetTimer);

    let ok = false;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText((emailEl.textContent ?? '').trim());
        ok = true;
      }
    } catch {
      ok = false;
    }

    if (ok) {
      setCopyLabel(true);
      status.textContent = btn.dataset[`status${lang}`] ?? '';
    } else {
      // Fallback: select the address so Ctrl+C / long-press works
      selectEmail();
      status.textContent = btn.dataset[`manual${lang}`] ?? '';
    }
    resetTimer = window.setTimeout(() => {
      setCopyLabel(false);
      status.textContent = '';
    }, 3000);
  }

  function initContact(): void {
    updateLinks();

    document.querySelectorAll('input[name="contact-intent"]').forEach((r) => {
      r.removeEventListener('change', updateLinks);
      r.addEventListener('change', updateLinks);
    });
    const copy = document.getElementById('contact-copy');
    copy?.removeEventListener('click', copyEmail);
    copy?.addEventListener('click', copyEmail);

    // Disconnect existing observer before re-creating (ClientRouter re-runs page-load)
    langObserver?.disconnect();
    langObserver = new MutationObserver(() => {
      updateLinks();
      if (document.getElementById('contact-copy')?.dataset.state !== 'done') setCopyLabel(false);
    });
    langObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
  }

  document.addEventListener('astro:page-load', initContact);
</script>
