---
// ThemeCurtain — full-screen overlay animation during theme switch
// Spinner: CSS Loaders pulse variant (css-loaders.com)
---

<div id="theme-curtain" class="curtain" aria-hidden="true" role="presentation">
  <div class="curtain-content">
    <!-- Themed message -->
    <p id="curtain-message-arepa" class="curtain-message" data-show-on="arepa">
      <span class="curtain-icon">
        <svg width="60" height="60" viewBox="0 0 100 100">
          <path d="M38 15 Q34 9 38 4 M52 15 Q48 9 52 4 M66 15 Q62 9 66 4" stroke="#C98A1A" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.4"/>
          <ellipse cx="50" cy="93" rx="34" ry="4" fill="#8A5A00" opacity="0.2"/>
          <path d="M10 54 v10 a40 30 0 0 0 80 0 v-10 z" fill="#B8761A"/>
          <path d="M14 70 Q50 100 86 70" stroke="#8A5A00" stroke-width="2" fill="none" opacity="0.35" stroke-linecap="round"/>
          <ellipse cx="50" cy="54" rx="40" ry="30" fill="#F5A623" stroke="#C98A1A" stroke-width="2"/>
          <ellipse cx="50" cy="54" rx="33" ry="23" fill="#F9B53C"/>
          <path d="M22 56 Q26 46 36 48 Q42 54 34 62 Q25 64 22 56Z" fill="#C98A1A" opacity="0.55"/>
          <path d="M58 62 Q66 54 76 58 Q80 66 70 70 Q60 70 58 62Z" fill="#C98A1A" opacity="0.55"/>
          <path d="M52 40 Q60 36 66 42 Q62 47 54 46Z" fill="#C98A1A" opacity="0.45"/>
          <ellipse cx="45" cy="66" rx="6" ry="3" fill="#8A5A00" opacity="0.3"/>
          <circle cx="72" cy="47" r="2.5" fill="#8A5A00" opacity="0.35"/>
          <circle cx="30" cy="40" r="2" fill="#8A5A00" opacity="0.3"/>
          <path d="M20 50 Q26 34 44 31" stroke="#FFD27A" stroke-width="4" stroke-linecap="round" fill="none" opacity="0.85"/>
          <ellipse cx="50" cy="35" rx="7" ry="2" fill="#FFD27A" opacity="0.55"/>
        </svg>
      </span>
      <span class="curtain-text">Haciendo las arepas...</span>
    </p>
    <p id="curtain-message-coffee" class="curtain-message" data-show-on="coffee">
      <span class="curtain-icon">
        <svg width="60" height="60" viewBox="0 0 100 100">
          <path d="M34 24 Q29 17 34 10 Q38 4 34 -1 M47 24 Q42 17 47 10 Q51 4 47 -1 M60 24 Q55 17 60 10 Q64 4 60 -1" stroke="#C9B89A" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.45"/>
          <ellipse cx="46" cy="92" rx="38" ry="3.5" fill="#000" opacity="0.35"/>
          <ellipse cx="46" cy="83" rx="40" ry="8" fill="#8F5A2A"/>
          <ellipse cx="46" cy="80" rx="40" ry="8" fill="#D49558"/>
          <ellipse cx="46" cy="79" rx="26" ry="5" fill="#B87438"/>
          <path d="M72 44 Q94 40 90 56 Q86 68 68 66" stroke="#8F5A2A" stroke-width="7" stroke-linecap="round" fill="none"/>
          <path d="M72 44 Q94 40 90 56 Q86 68 68 66" stroke="#C8874A" stroke-width="4" stroke-linecap="round" fill="none"/>
          <path d="M18 38 Q18 79 46 79 Q74 79 74 38 Z" fill="#C8874A"/>
          <path d="M64 46 Q64 70 46 76 Q70 76 74 38 Z" fill="#8F5A2A" opacity="0.45"/>
          <ellipse cx="46" cy="38" rx="28" ry="9" fill="#E8A96B"/>
          <ellipse cx="46" cy="39" rx="24" ry="7" fill="#3B2416"/>
          <ellipse cx="42" cy="38" rx="13" ry="3.5" fill="#8B5A2B" opacity="0.7"/>
          <path d="M25 46 Q27 66 38 73" stroke="#F5EBD8" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.5"/>
          <path d="M30 33 Q40 29 52 30" stroke="#F5EBD8" stroke-width="2" stroke-linecap="round" fill="none" opacity="0.5"/>
        </svg>
      </span>
      <span class="curtain-text">Sirviendo café...</span>
    </p>

    <!-- CSS Loaders — Pulse spinner -->
    <div class="loader" aria-hidden="true"></div>
  </div>
</div>

<style>
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-100%);
    transition: opacity 0.3s ease;
  }

  /* Default curtain background */
  .curtain::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transition: background 0.3s ease;
  }

  /* Target: Arepa (Light mode) */
  .curtain[data-target-theme="arepa"]::before {
    background: linear-gradient(135deg, #FDFBF7 0%, #F5F1E6 50%, #EBE4D5 100%);
  }

  /* Target: Coffee (Dark mode) */
  .curtain[data-target-theme="coffee"]::before {
    background: linear-gradient(135deg, #110D0A 0%, #1C1410 50%, #241A14 100%);
  }

  .curtain.curtain-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
    animation: curtain-slide-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .curtain.curtain-leaving {
    animation: curtain-slide-out 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes curtain-slide-in {
    from { transform: translateY(-100%); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }

  @keyframes curtain-slide-out {
    from { transform: translateY(0); opacity: 1; }
    to   { transform: translateY(-100%); opacity: 1; }
  }

  .curtain-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .curtain-message {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-heading);
    text-align: center;
  }

  .curtain-message.visible {
    display: flex;
  }

  .curtain-icon {
    font-size: 3rem;
    color: var(--color-primary);
    filter: drop-shadow(0 0 10px var(--color-primary));
    animation: bounce-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .curtain-text {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    text-shadow: 0 0 20px var(--color-primary);
    letter-spacing: 0.05em;
    animation: fade-slide-up 0.4s ease 0.1s both;
  }

  @keyframes bounce-in {
    from { transform: scale(0.3); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  @keyframes fade-slide-up {
    from { transform: translateY(10px); opacity: 0; }
    to   { transform: translateY(0); opacity: 1; }
  }

  /* ── CSS Loaders — Pulse ── */
  .loader {
    width: 40px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 0 var(--color-primary);
    animation: pulse-loader 1.2s ease-in-out infinite;
    opacity: 0.8;
  }

  /* Arepa (Light) overrides */
  .curtain[data-target-theme="arepa"] .loader {
    background: #F5A623;
    animation: pulse-loader-arepa 1.2s ease-in-out infinite;
  }

  @keyframes pulse-loader-arepa {
    0%   { box-shadow: 0 0 0 0 rgba(245,166,35,0.6); }
    70%  { box-shadow: 0 0 0 20px rgba(245,166,35,0); }
    100% { box-shadow: 0 0 0 0 rgba(245,166,35,0); }
  }

  /* Coffee (Dark) overrides */
  .curtain[data-target-theme="coffee"] .loader {
    background: #C8874A;
    animation: pulse-loader-coffee 1.2s ease-in-out infinite;
  }

  @keyframes pulse-loader-coffee {
    0%   { box-shadow: 0 0 0 0 rgba(200,135,74,0.6); }
    70%  { box-shadow: 0 0 0 20px rgba(200,135,74,0); }
    100% { box-shadow: 0 0 0 0 rgba(200,135,74,0); }
  }
</style>

<script>
  let curtainObserver: MutationObserver | null = null;

  function initThemeCurtain(): void {
    const curtain = document.getElementById('theme-curtain');
    if (!curtain) return;

    // Disconnect existing observer before re-creating
    if (curtainObserver) {
      curtainObserver.disconnect();
      curtainObserver = null;
    }

    curtainObserver = new MutationObserver(() => {
      if (curtain.classList.contains('curtain-active')) {
        const targetTheme = curtain.getAttribute('data-target-theme') || 'coffee';
        document.querySelectorAll<HTMLElement>('.curtain-message').forEach((msg) => {
          msg.classList.remove('visible');
        });
        const target = document.querySelector<HTMLElement>(
          `.curtain-message[data-show-on="${targetTheme}"]`
        );
        target?.classList.add('visible');
      }
    });
    curtainObserver.observe(curtain, { attributes: true, attributeFilter: ['class'] });
  }

  document.addEventListener('astro:page-load', initThemeCurtain);
</script>
